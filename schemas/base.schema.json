{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["_meta", "sections"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["pipeline_version", "source_file", "document_type", "extraction_timestamp"],
      "properties": {
        "pipeline_version": { "type": "string" },
        "source_file": { "type": "string" },
        "document_type": { "type": ["string", "null"] },
        "extraction_timestamp": { "type": "string", "format": "date-time" },
        "image_placeholder_count": { "type": "integer" },
        "llm_model": { "type": "string" },
        "inferred_schema_version": { "type": "string" },
        "raw_text_fallback": { "type": ["string", "null"] },
        "_extraction_status": { "type": ["string", "null"] }
      }
    },
    "sections": {
      "type": "object",
      "description": "Top-level sections as identified by the LLM. Keys are section names (snake_case). Values are section content objects whose structure is defined by the inferred schema.",
      "properties": {
        "document_control": { "type": "object", "additionalProperties": true },
        "document_change_history": { "type": "array", "items": { "type": "object" } },
        "introduction": { "type": "object", "additionalProperties": true },
        "engagement_scope": { "type": "object", "additionalProperties": true },
        "executive_summary": { "type": "object", "additionalProperties": true },
        "detailed_observations": {
          "type": "array",
          "description": "A list of explicitly detailed vulnerability observations found in the report.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "vulnerability_title": { "type": "string" },
              "affected_assets": { "type": "string" },
              "description": { "type": "string" },
              "impact": { "type": "string" },
              "recommendation": { "type": "string" },
              "risk_rating": { "type": "string" },
              "cve_cwe": { "type": "string" },
              "status": { "type": "string" }
            },
            "required": ["vulnerability_title", "description", "impact", "recommendation"]
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
